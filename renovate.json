{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main"],
  "enabledManagers": ["gomod"],
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "prCreation": "approval",
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpgradeTasks": {
    "commands": ["make vendor"],
    "fileFilters": ["go.mod", "go.sum", "vendor/**"]
  },
  "labels": ["release-note-none"],
  "extends": [":gitSignOff"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "additionalBranchPrefix": "security/",
    "prCreation": "approval",
    "recreateWhen": "always"
  },
  "osvVulnerabilityAlerts": true,
  "assigneesFromCodeOwners": true,
  "separateMajorMinor": true,
  "ignorePaths": [
    "**/vendor/**"
  ]
}
